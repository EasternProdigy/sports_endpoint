# Copy to .dev.vars for local `wrangler dev`
CONTROL_TOKEN=replace-me

# Optional for local testing (can also stay in wrangler.toml [vars])
SPORTS_API_URL=https://example.com/sports
NCAA_SOFTBALL_API_URL=https://example.com/ncaa-softball
NCAA_BASKETBALL_API_URL=https://example.com/ncaa-basketball
OLYMPICS_API_URL=https://example.com/olympics
SOCCER_API_URL=https://example.com/soccer
INDIVIDUAL_SPORTS_API_URL=https://example.com/individual
WELLESLEY_SOFTBALL_URL=https://athletics.wellesley.edu/sports/softball/schedule_text
